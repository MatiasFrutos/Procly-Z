{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Procly",
  "version": "0.1.0",
  "identifier": "dev.procly.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Procly",
        "label": "main",
        "width": 1000,
        "height": 680,
        "minWidth": 640,
        "minHeight": 420,
        "center": true,
        "backgroundColor": "#0D0F13"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"],
    "category": "Utility",
    "shortDescription": "Visor y terminador de procesos",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
